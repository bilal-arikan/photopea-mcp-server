{
  "name": "photopea-mcp-server",
  "version": "0.2.0",
  "description": "MCP server for AI-driven image editing with Photopea (headless mode + text overlay support)",
  "author": "bilal-arikan",
  "contributors": [
    "attalla1 (original author & base implementation)",
    "bilal-arikan (headless mode, text-overlay, reliability fixes)"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bilal-arikan/photopea-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/bilal-arikan/photopea-mcp-server/issues"
  },
  "homepage": "https://github.com/bilal-arikan/photopea-mcp-server#readme",
  "keywords": [
    "modelcontextprotocol",
    "mcp",
    "photopea",
    "image-editing",
    "ai"
  ],
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "src/frontend",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "photopea-mcp-server": "dist/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "start:headless": "node dist/index.js --headless",
    "dev": "tsx watch src/index.ts",
    "dev:headless": "tsx watch src/index.ts --headless",
    "headless:setup": "playwright install chromium",
    "build": "tsc && chmod 755 dist/index.js",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "open": "^10.1.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.0"
  }
}
